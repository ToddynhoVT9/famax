# O build precisa das devDependencies: `npm run build` chama vite e tsc, e os
# dois são devDependencies. Com NODE_ENV=production no ambiente, o npm omite
# dev sozinho — foi o que quebrou o deploy no Hostinger com
# "sh: vite: command not found".
#
# `include` tem precedência sobre `omit` independente da ordem, então isto
# derrota o omit implícito do NODE_ENV.
include=dev
