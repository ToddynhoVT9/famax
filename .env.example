# Copie para .env e preencha. O .env é ignorado pelo git.

# --- Banco de dados ---------------------------------------------------------

# external = Postgres de verdade, exige DATABASE_URL abaixo. É o modo de
#            PRODUÇÃO.
# embedded = Postgres em WASM (PGlite) dentro do próprio processo, persistindo
#            em disco. Só para desenvolvimento: o PGlite não tranca o
#            diretório de dados, então duas instâncias no mesmo
#            PGLITE_DATA_DIR corrompem o banco — e hospedagem gerenciada
#            costuma rodar mais de uma. Ver server/embedded-db.ts.
DB_MODE=external

# --- Obrigatórias no modo external (o servidor não sobe sem elas) -----------

# Connection string do Postgres. Qualquer Postgres serve.
#
# Supabase: Project Settings > Database > Connection string.
# Use a do POOLER em modo SESSÃO (porta 5432, host "...pooler.supabase.com",
# usuário "postgres.<ref>"). Não use a porta 6543: aquela é modo transação,
# pensada para serverless, e este app mantém conexões longas com pool próprio.
DATABASE_URL=postgresql://postgres.SEU_REF:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# Vigia do banco: uma query a cada N segundos. Mantém o dbState honesto (sem
# ela um banco fora do ar continuaria liberando as rotas, que responderiam 500
# em vez de 503) e impede a PAUSA por inatividade do plano free do Supabase,
# que exige restore manual no dashboard.
#
# 60s é irrelevante no Supabase free, que não tem cota de compute. Se um dia
# trocar para um provedor que cobra por compute ligado (Neon), aumente para a
# casa dos minutos: uma sonda a cada 60s mantém o banco acordado 24/7.
# DB_PROBE_SECONDS=60

# Segredo de assinatura dos JWT. Mínimo 32 caracteres, aleatório.
# Obrigatório nos dois modos.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Opcionais do modo embedded --------------------------------------------

# Onde o banco fica em disco. ATENÇÃO em produção: se o deploy substitui a
# pasta do projeto, um caminho relativo como ./data/pglite é apagado a cada
# publicação. Use um caminho absoluto FORA da pasta do app.
# PGLITE_DATA_DIR=./data/pglite

# Porta do socket local que o PGlite abre. Só precisa mudar se 55500 já estiver
# em uso na máquina.
# PGLITE_PORT=55500

# --- Opcionais --------------------------------------------------------------

PORT=3000
NODE_ENV=development
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Proxies reversos confiáveis à frente da API (app.set("trust proxy")). Sem
# isto, atrás do proxy da hospedagem o req.ip é o IP do PROXY, e o rate limit
# de login/cadastro (que é por IP) passa a barrar todos os usuários juntos.
#   1         um proxy à frente (o caso comum em hospedagem gerenciada)
#   true      confia em qualquer X-Forwarded-For — só se o proxy o reescreve
#   loopback  nomes/IPs/sub-redes no formato do Express
# Vazio/false (padrão) não confia em nenhum: correto ao rodar sem proxy, já
# que confiar no header deixaria o cliente escolher o próprio IP.
# TRUST_PROXY=1

# Aplica as migrations pendentes de server/sql ao subir (modo external), antes
# de liberar a API. Ligado por padrão; "false" volta ao npm run migrate manual.
# MIGRATE_ON_BOOT=true

# --- Tempo real (chat e notificações por SSE) --------------------------------

# Barramento entre instâncias (server/lib/realtime.ts):
#   postgres  LISTEN/NOTIFY — funciona com várias instâncias (padrão no external)
#   memory    só o próprio processo (padrão no embedded; uma instância só)
# REALTIME_BUS=postgres
#
# O LISTEN precisa de conexão de SESSÃO. Se a DATABASE_URL for o pooler do
# Supabase em modo transação (porta 6543), aponte esta para a conexão direta
# ou para o pooler em modo sessão (porta 5432). Vazia = usa a DATABASE_URL.
# REALTIME_DATABASE_URL=

# --- Conta e segurança ---------------------------------------------------------

# Endereço público do site, usado nos links dos e-mails (verificação de
# e-mail). Sem ela: em dev, http://localhost:5173 (o Vite); em produção, o
# host da requisição — e o servidor avisa no boot, porque o header Host vem
# do cliente.
# APP_URL=https://famax.seudominio.com

# Chave dos segredos da verificação em duas etapas (AES-256-GCM): 32 bytes em
# hex. Sem ela a 2FA fica indisponível. NÃO troque depois que alguém ativar:
# os segredos cifrados com a chave antiga deixam de abrir.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TWO_FACTOR_KEY=

# --- E-mail (recuperação de senha e verificação) -----------------------------

# console = só imprime o e-mail no log (padrão; dev e testes). Em produção
#           ninguém recebe o código de recuperação — o servidor avisa no boot.
# resend  = API HTTP do Resend (https://resend.com). Exige RESEND_API_KEY.
# smtp    = qualquer servidor SMTP. Exige SMTP_URL.
# MAIL_PROVIDER=console

# Remetente. Obrigatório com resend/smtp; no Resend o domínio precisa estar
# verificado no painel deles.
# MAIL_FROM=FAMAX <nao-responda@seudominio.com>

# RESEND_API_KEY=re_...

# smtps:// para TLS direto (porta 465); smtp:// usa STARTTLS (porta 587).
# Caracteres especiais na senha precisam de URL-encoding (@ vira %40).
# SMTP_URL=smtps://usuario:senha@smtp.seudominio.com:465

# Desliga o SSL no modo external (Postgres local recusa a negociação).
# No modo embedded isso é automático.
# DATABASE_SSL=false

# Upload das capas de comunidade. Sem estas vars o upload é desativado e a
# comunidade é criada sem capa — o resto do fluxo continua funcionando.
# SUPABASE_URL: Supabase > Project Settings > API > Project URL
# SUPABASE_SERVICE_KEY: a chave service_role (NUNCA expor no frontend)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_COVERS_BUCKET=community-covers
